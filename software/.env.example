GROQ_API_KEY=coloque_sua_chave_aqui

# Tela lógica 1024x1080 em monitor 1920x1080. O Pygame/SDL centraliza a
# imagem em fullscreen e preenche o espaço lateral restante com barras pretas.
BMO_LOGICAL_WIDTH=1024
BMO_LOGICAL_HEIGHT=1080
BMO_DISPLAY_WIDTH=1920
BMO_DISPLAY_HEIGHT=1080
BMO_FULLSCREEN=1
BMO_FPS=60
BMO_BAR_COLOR=0,0,0

# Ritmo dos jogos
BMO_SNAKE_FPS=6
BMO_SNAKE_CELL_SIZE=60
BMO_SPACE_PLAYER_SPEED=9
BMO_SPACE_ENEMY_SPEED_FACTOR=0.55
BMO_SPACE_MOTHERSHIP_SPEED=1.8
BMO_SPACE_SPAWN_FRAMES=90

# Microfone e detecção de voz
BMO_MIC_INDEX=
BMO_TIMEOUT_ESCUTA=6
BMO_LIMITE_FALA=10
BMO_PAUSA_FIM_FALA=0.75
BMO_DURACAO_AJUSTE_RUIDO=0.7
BMO_INTERVALO_RUIDO=30
BMO_CALIBRAR_TODA_VEZ=0
BMO_ENERGIA_MINIMA=120
BMO_ENERGIA_MAXIMA=4000
BMO_LIMITE_SEM_FALA=0.65
BMO_LIMITE_LOGPROB=-0.85
BMO_SALVAR_TRANSCRICOES=1

# Áudio e hardware
BMO_AUDIO_DEVICE=
# Opcional. Deixe comentado para usar backend/vozes/dii_pt-BR.onnx.
# BMO_VOZ_PIPER=vozes/dii_pt-BR.onnx
BMO_PORTA_SERIAL_BRACOS=COM5
BMO_BAUD_SERIAL_BRACOS=115200
BMO_TENTATIVAS_API=2
